6. View Food
void viewFood()
{
    if(foods.empty())
    {
        cout << "No Food Available!" << endl;
        return;
    }


    for(int i = 0; i < foods.size(); i++)
    {
        if(foods[i].getQuantity() > 0)
        {
            foods[i].display();
        }
    }
}

শুধু যেসব food-এর quantity 0 না, সেগুলো দেখাবে।

7. Search Food
void searchFood()
{
    string keyword;


    cout << "Enter Food Name: ";
    cin >> keyword;


    bool found = false;


    for(int i = 0; i < foods.size(); i++)
    {
        if(foods[i].getName() == keyword &&
           foods[i].getQuantity() > 0)
        {
            foods[i].display();
            found = true;
        }
    }


    if(found == false)
    {
        cout << "Food Not Found!" << endl;
    }
}
found কেন?

Search করার পরে food পাওয়া গেছে কি না track করার জন্য।

