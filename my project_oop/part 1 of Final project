এগুলো দিয়ে FoodItem-এর data নেওয়া হয়।

Quantity change
void setQuantity(int q)
{
    quantity = q;
}

Order দেওয়ার পরে quantity কমানোর জন্য।

Discount calculation
double getFinalPrice()
{
    return price - (price * discount / 100);
}

ধরো:

Price = 100
Discount = 20%

তাহলে:

100 - (100 × 20 / 100)
= 80

Final price = 80

Display function
void display()
{
    cout << "ID          : " << id << endl;
    cout << "Food        : " << name << endl;
    cout << "Restaurant  : " << restaurant << endl;
    cout << "Price       : " << price << endl;
    cout << "Discount    : " << discount << "%" << endl;
    cout << "Final Price : " << getFinalPrice() << endl;
    cout << "Quantity    : " << quantity << endl;
    cout << "Expiry      : " << expiry << endl;
    cout << "-----------------------------" << endl;
}

