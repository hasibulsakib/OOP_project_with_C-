1. Customer Menu
void customerMenu()
{
    int choice;


    do
    {
        cout << "\n========== CUSTOMER MENU ==========\n";


        cout << "1. View Food\n";
        cout << "2. Search Food\n";
        cout << "3. Place Order\n";
        cout << "4. Logout\n";


        cout << "Enter Choice: ";
        cin >> choice;




        if(choice == 1)
            viewFood();


        else if(choice == 2)
            searchFood();


        else if(choice == 3)
            placeOrder();


        else if(choice == 4)
            logout();


        else
            cout << "Invalid Choice!" << endl;


    }while(choice != 4);
}

Customer তিনটা কাজ করতে পারে:

Food দেখা
Food search করা
Order করা
