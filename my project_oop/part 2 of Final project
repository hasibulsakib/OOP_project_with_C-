6. Load Users
void loadUsers()
{
    ifstream file("users.txt");


    string username;
    string password;
    string role;


    while(file >> username >> password >> role)
    {
        users.push_back(
            User(username, password, role)
        );
    }


    file.close();
}
কী হচ্ছে?

users.txt file থেকে data পড়ছি।

ধরো file:

sakib 123456 Customer
rahim 456789 Restaurant

তাহলে দুইটা User object তৈরি হয়ে vector-এ যাবে।

7. Save Users
void saveUsers()
{
    ofstream file("users.txt");


    for(int i = 0; i < users.size(); i++)
    {
        file << users[i].getUsername() << " "
             << users[i].getPassword() << " "
             << users[i].getRole()
             << endl;
    }


    file.close();
}
কী হচ্ছে?

Vector-এর সব user file-এ save হচ্ছে।

8. Load Foods
void loadFoods()
{
    ifstream file("food_items.txt");


    int id;
    int quantity;


    string name;
    string restaurant;
    string expiry;


    double price;
    double discount;


    while(file >> id
              >> name
              >> restaurant
              >> price
              >> discount
              >> quantity
              >> expiry)
    {
        foods.push_back(
            FoodItem(
                id,
                name,
                restaurant,
                price,
                discount,
                quantity,
                expiry
            )
        );
    }


    file.close();
}

Food file থেকে food data নিয়ে FoodItem object বানানো হচ্ছে।

9. Save Foods
void saveFoods()
{
    ofstream file("food_items.txt");


    for(int i = 0; i < foods.size(); i++)
    {
        file << foods[i].getId() << " "
             << foods[i].getName() << " "
             << foods[i].getRestaurant() << " "
             << foods[i].getPrice() << " "
             << foods[i].getDiscount() << " "
             << foods[i].getQuantity() << " "
             << foods[i].getExpiry()
             << endl;
    }


    file.close();
}

Food vector-এর data file-এ save হয়।

